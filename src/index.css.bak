.custom-toast{
position:fixed;
top:30px;
right:30px;
background:#111;
color:#fff;
padding:14px 22px;
border-radius:12px;
z-index:99999;
opacity:0;
transform:translateY(-20px);
transition:.35s;
font-weight:500;
}

.custom-toast.show{
opacity:1;
transform:translateY(0);
}

.custom-toast.success{
background:#16a34a;
}

.custom-toast.error{
background:#dc2626;
}

.success-popup{
position:fixed;
inset:0;
background:rgba(0,0,0,.5);
display:flex;
align-items:center;
justify-content:center;
z-index:999999;
opacity:0;
transition:.3s;
}

.success-popup.show{
opacity:1;
}

.success-box{
background:#fff;
padding:35px 30px;
border-radius:20px;
text-align:center;
max-width:340px;
box-shadow:0 10px 40px rgba(0,0,0,.15);
}

.success-icon{
width:70px;
height:70px;
line-height:70px;
margin:auto auto 15px;
background:#16a34a;
color:#fff;
font-size:34px;
border-radius:50%;
font-weight:700;
}
/*
 * Webzygo Bulk Enquiry — style.css
 * Primary: rgb(255, 155, 81)
 * Font: 'Cormorant Garamond' (headings) + 'DM Sans' (body)
 */

/* ── GOOGLE FONTS ────────────────────────────────────────────────────────── */
/* @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=DM+Sans:wght@300;400;500;600&display=swap'); */

/* ── CSS VARIABLES ───────────────────────────────────────────────────────── */
:root {
    --wze-primary:        #795548;
    --wze-primary-dark:   #795548;
    --wze-primary-light:  #FDFBD4;
    --wze-primary-mid:    #795548;

    --wze-ink:            #1a1008;
    --wze-ink-light:      #6b5b47;
    --wze-ink-muted:      #a0897a;

    --wze-bg:             #FDFBD4;
    --wze-card-bg:        #fffcf8;
    --wze-border:         #ede5da;
    --wze-border-focus:   var(--wze-primary);

    --wze-white:          #ffffff;
    --wze-success:        #3dbf7f;
    --wze-error:          #e05252;

    --wze-radius-sm:      6px;
    --wze-radius:         14px;
    --wze-radius-lg:      20px;

    --wze-shadow:         0 2px 16px rgba(100, 60, 20, 0.08);
    --wze-shadow-hover:   0 6px 28px rgba(255, 155, 81, 0.18);

    --wze-transition:     0.2s ease;
}

.woocommerce-page .wd-negative-gap{
	background : #f8fafc !important;
}

/* ── RESET ───────────────────────────────────────────────────────────────── */
.wze-wrap *,
.wze-wrap *::before,
.wze-wrap *::after {
    box-sizing: border-box;
}

/* ── WRAPPER ─────────────────────────────────────────────────────────────── */
.wze-wrap {
    max-width: 828px;
    margin: 0 auto;
    padding: 48px 24px 64px;
    background: var(--wze-bg);
    font-family: 'Inter', sans-serif;
    color: var(--wze-ink);
}

/* ── HERO HEADER ─────────────────────────────────────────────────────────── */
.wze-hero {
    text-align: center;
    margin-bottom: 48px;
}

.wze-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--wze-primary);
    margin: 0 0 14px;
    text-transform: uppercase;
}

.wze-hero-title {
    font-family: 'Manrope', serif;
    font-size: clamp(36px, 6vw, 54px);
    font-weight: 400;
    line-height: 1.15;
    color: var(--wze-ink);
    margin: 0 0 16px;
}

.wze-hero-title em {
    font-style: italic;
    color: var(--wze-primary);
}

.wze-hero-sub {
    font-size: 15px;
    color: var(--wze-ink-light);
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.6;
}

/* ── CARDS ───────────────────────────────────────────────────────────────── */
.wze-card {
    background: var(--wze-card-bg);
    border: 1px solid var(--wze-border);
    border-radius: var(--wze-radius-lg);
    padding: 28px 32px;
    margin-bottom: 20px;
    box-shadow: var(--wze-shadow);
    transition: box-shadow var(--wze-transition);
}

.wze-card:hover {
    box-shadow: 0 4px 24px rgba(255, 155, 81, 0.08);
}

/* ── CARD HEADER ─────────────────────────────────────────────────────────── */
.wze-card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
}

.wze-section-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--wze-ink-light);
}

.wze-badge {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border-radius: 20px;
    text-transform: uppercase;
}

.wze-badge--required {
    background: var(--wze-primary-light);
    color: var(--wze-primary-dark);
    border: 1px solid var(--wze-primary-mid);
}

.wze-badge--optional {
    background: #f1ece6;
    color: var(--wze-ink-muted);
    border: 1px solid var(--wze-border);
}

/* ── GRID ────────────────────────────────────────────────────────────────── */
.wze-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

@media (max-width: 560px) {
    .wze-grid-2 {
        grid-template-columns: 1fr;
    }
}

/* ── FIELDS ──────────────────────────────────────────────────────────────── */
.wze-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.wze-field label {
    font-size: 12px;
    font-weight: 500;
    color: var(--wze-ink-light);
    letter-spacing: 0.02em;
}

.wze-req { color: var(--wze-primary); }
.wze-opt { color: var(--wze-ink-muted); font-weight: 400; }

.wze-wrap input[type="text"],
.wze-wrap input[type="email"],
.wze-wrap textarea {
    width: 100%;
    padding: 11px 14px;
    background: var(--wze-white);
    border: 1.5px solid var(--wze-border);
    border-radius: var(--wze-radius-sm);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--wze-ink);
    transition: border-color var(--wze-transition), box-shadow var(--wze-transition);
    outline: none;
    -webkit-appearance: none;
}

.wze-wrap input::placeholder,
.wze-wrap textarea::placeholder {
    color: var(--wze-ink-muted);
}

.wze-wrap input:focus,
.wze-wrap textarea:focus {
    border-color: var(--wze-primary);
    box-shadow: 0 0 0 3px var(--wze-primary-light);
}

.wze-wrap input.wze-input--error {
    border-color: var(--wze-error);
    box-shadow: 0 0 0 3px rgba(224, 82, 82, 0.12);
}

.wze-wrap textarea {
    resize: vertical;
    min-height: 110px;
    line-height: 1.6;
}

/* ── SELECT WRAPPER ──────────────────────────────────────────────────────── */
.wze-select-wrap {
    position: relative;
    display: flex;
    align-items: center;
}

.wze-select-wrap select {
    width: 100%;
    padding: 11px 36px 11px 14px;
    background: var(--wze-white);
    border: 1.5px solid var(--wze-border);
    border-radius: var(--wze-radius-sm);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--wze-ink);
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition: border-color var(--wze-transition), box-shadow var(--wze-transition);
    outline: none;
}

.wze-select-wrap select:focus {
    border-color: var(--wze-primary);
    box-shadow: 0 0 0 3px var(--wze-primary-light);
}

.wze-chevron {
    position: absolute;
    right: 12px;
    pointer-events: none;
    width: 16px;
    height: 16px;
    stroke: var(--wze-ink-muted);
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
}

/* ── HINT TEXT ───────────────────────────────────────────────────────────── */
.wze-hint {
    font-size: 13px;
    color: var(--wze-ink-muted);
    margin: -10px 0 18px;
    line-height: 1.5;
}

/* ── INGREDIENT TABLE HEADER ─────────────────────────────────────────────── */
.wze-ing-header {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 36px;
    gap: 10px;
    padding: 0 0 8px;
    border-bottom: 1px solid var(--wze-border);
    margin-bottom: 12px;
}

.wze-ing-header span {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--wze-ink-muted);
    text-transform: uppercase;
}

/* ── INGREDIENT ROW ──────────────────────────────────────────────────────── */
.wze-ing-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 36px;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
    transition: opacity 0.2s ease, transform 0.2s ease;
}

.wze-ing-row.wze-row--entering {
    opacity: 0;
    transform: translateY(-6px);
}

.wze-ing-row.wze-row--removing {
    opacity: 0;
    transform: translateY(-4px);
}

/* stretch select wrappers inside the row */
.wze-ing-herb,
.wze-ing-form,
.wze-ing-qty {
    min-width: 0;
}

.wze-ing-herb .wze-select-wrap,
.wze-ing-form .wze-select-wrap,
.wze-ing-qty  .wze-select-wrap {
    width: 100%;
}

/* ── DELETE BUTTON ───────────────────────────────────────────────────────── */
.wze-del-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 1.5px solid var(--wze-border);
    border-radius: 50%;
    background: var(--wze-white);
    color: var(--wze-ink-muted);
    cursor: pointer;
    transition: all var(--wze-transition);
    flex-shrink: 0;
    padding: 0;
}

.wze-del-btn:hover {
    border-color: var(--wze-error);
    color: var(--wze-error);
    background: rgba(224, 82, 82, 0.06);
}

.wze-del-btn--hidden {
    opacity: 0;
    pointer-events: none;
}

/* ── ADD HERB BUTTON ─────────────────────────────────────────────────────── */
.wze-add-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    padding: 9px 18px;
    background: transparent;
    border: 1.5px dashed var(--wze-primary-mid);
    border-radius: var(--wze-radius-sm);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--wze-primary-dark);
    cursor: pointer;
    transition: all var(--wze-transition);
}

.wze-add-btn:hover {
    background: var(--wze-primary-light);
    border-color: var(--wze-primary);
}

.wze-add-btn svg {
    flex-shrink: 0;
}

/* ── TAGS ────────────────────────────────────────────────────────────────── */
.wze-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.wze-tag {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background: var(--wze-white);
    border: 1.5px solid var(--wze-border);
    border-radius: 30px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: var(--wze-ink-light);
    cursor: pointer;
    transition: all var(--wze-transition);
}

.wze-tag:hover {
    border-color: var(--wze-primary);
    color: var(--wze-primary-dark);
}

.wze-tag--active {
    background: var(--wze-primary);
    border-color: var(--wze-primary);
    color: var(--wze-white);
    font-weight: 500;
}

.wze-tag--active:hover {
    background: var(--wze-primary-dark);
    border-color: var(--wze-primary-dark);
    color: var(--wze-white);
}

/* ── SUBMIT AREA ─────────────────────────────────────────────────────────── */
.wze-submit-wrap {
    text-align: center;
    margin-top: 12px;
}

.wze-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 380px;
    padding: 16px 32px;
    background: var(--wze-primary);
    color: var(--wze-white);
    border: none;
    border-radius: var(--wze-radius-sm);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all var(--wze-transition);
    position: relative;
    overflow: hidden;
}

.wze-submit-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 100%);
    opacity: 0;
    transition: opacity var(--wze-transition);
}

.wze-submit-btn:hover {
    background: var(--wze-primary-dark);
    box-shadow: var(--wze-shadow-hover);
    transform: translateY(-1px);
	color : #fff;
}

.wze-submit-btn:hover::before { opacity: 1; }

.wze-submit-btn:active {
    transform: translateY(0);
    box-shadow: none;
}

.wze-submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
}

/* spinner (hidden by default) */
.wze-btn-spinner {
    display: none;
    animation: wze-spin 0.7s linear infinite;
    flex-shrink: 0;
	width : 20px;
	height : 20px;
}

.wze-submit-btn.wze-btn--loading .wze-btn-spinner { display: block; }
.wze-submit-btn.wze-btn--loading .wze-btn-text   { opacity: 0.7; }

.wze-submit-btn.wze-btn--success {
    background: var(--wze-success);
}

.wze-submit-btn.wze-btn--error {
    background: var(--wze-error);
}

@keyframes wze-spin {
    to { transform: rotate(360deg); }
}

.wze-submit-note {
    font-size: 12px;
    color: var(--wze-ink-muted);
    margin-top: 12px;
}

/* ── CONTACT FOOTER ──────────────────────────────────────────────────────── */
.wze-contact-footer {
    margin-top: 48px;
    padding: 32px;
    background: var(--wze-card-bg);
    border: 1px solid var(--wze-border);
    border-radius: var(--wze-radius-lg);
    text-align: center;
}

.wze-contact-footer p {
    font-size: 16px;
    color: var(--wze-ink);
    margin: 0 0 6px;
}

.wze-contact-footer strong {
    color: var(--wze-primary-dark);
}

.wze-contact-sub {
    font-size: 13px !important;
    color: var(--wze-ink-muted) !important;
    max-width: 420px;
    margin: 0 auto 24px !important;
    line-height: 1.6;
}

.wze-contact-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
}

.wze-whatsapp-btn,
.wze-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    border-radius: var(--wze-radius-sm);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all var(--wze-transition);
}

.wze-whatsapp-btn {
    background: #25d366;
    color: #fff;
}

.wze-whatsapp-btn:hover {
    background: #1dbc59;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.3);
    transform: translateY(-1px);
	color : #fff;
}

.wze-email-btn {
    background: transparent;
    color: var(--wze-ink);
    border: 1.5px solid var(--wze-border);
}

.wze-email-btn:hover {
    border-color: var(--wze-primary);
    color: var(--wze-primary-dark);
    transform: translateY(-1px);
}

/* ── RESPONSIVE ──────────────────────────────────────────────────────────── */
@media (max-width: 620px) {
    .wze-card {
        padding: 22px 18px;
        border-radius: var(--wze-radius);
    }

    .wze-ing-header,
    .wze-ing-row {
        grid-template-columns: 1fr 1fr 36px;
    }

    /* hide qty column header on tiny screens */
    .wze-ing-header span:nth-child(3) { display: none; }

    .wze-ing-qty { display: none; }

    .wze-wrap {
        padding: 28px 16px 48px;
    }
}
.webzygo-enquiry{
