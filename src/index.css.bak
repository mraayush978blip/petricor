@font-face{ font-display:swap;
	font-weight: normal;
	font-style: normal;
	font-family: "woodmart-font";
	src: url("//petricor.co.in/wp-content/themes/woodmart/fonts/woodmart-font-2-400.woff2?v=8.5.4") format("woff2");
 }

@font-face{ font-display:swap;
	font-family: "star";
	font-weight: 400;
	font-style: normal;
	src: url("//petricor.co.in/wp-content/plugins/woocommerce/assets/fonts/star.eot?#iefix") format("embedded-opentype"), url("//petricor.co.in/wp-content/plugins/woocommerce/assets/fonts/star.woff") format("woff"), url("//petricor.co.in/wp-content/plugins/woocommerce/assets/fonts/star.ttf") format("truetype"), url("//petricor.co.in/wp-content/plugins/woocommerce/assets/fonts/star.svg#star") format("svg");
 }

@font-face{ font-display:swap;
	font-family: "WooCommerce";
	font-weight: 400;
	font-style: normal;
	src: url("//petricor.co.in/wp-content/plugins/woocommerce/assets/fonts/WooCommerce.eot?#iefix") format("embedded-opentype"), url("//petricor.co.in/wp-content/plugins/woocommerce/assets/fonts/WooCommerce.woff") format("woff"), url("//petricor.co.in/wp-content/plugins/woocommerce/assets/fonts/WooCommerce.ttf") format("truetype"), url("//petricor.co.in/wp-content/plugins/woocommerce/assets/fonts/WooCommerce.svg#WooCommerce") format("svg");
 }


