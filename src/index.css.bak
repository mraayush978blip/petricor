.wc-compliance {
  width: 100%;
  padding: 20px 15px;
  box-sizing: border-box;
}

/* TITLE */
.wc-compliance .wc-title {
  margin-bottom: 20px;
  color : #94a3b8;	
}

.wc-compliance .wc-item > h3{
	font-size: 16px;
  	letter-spacing: 1px;
  	color: rgba(0,0,0,0.8);
	font-weight: 600;
	margin-bottom : 4px !important;
}

.wc-compliance .wc-item > p{
	font-size: 12px;
  	letter-spacing: 1px;
  	color: #8a8a8a;
	font-weight: 400;
	margin-bottom : 4px !important;
}

/* LIST */
.wc-compliance .wc-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ITEM */
.wc-compliance .wc-item {
  width: 100%;
  background: #fff;
  padding: 16px 18px;
  border-radius: 10px;
  font-size: 14px;
  color: #222;
  border: 1px solid #f1f5f9;
  transition: all 0.3s ease;
  --tw-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --tw-shadow-colored: 0 1px 2px 0 var(--tw-shadow-color);
    box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);
}

/* HOVER */
.wc-compliance .wc-item:hover {
  border-color: var(--e-global-color-e7b6afb);
  background: #fff;
}

/* HIGHLIGHT */
.wc-compliance .wc-highlight {
  background: rgba(121,85,72,.2);
  border: 1px solid var(--e-global-color-e7b6afb);
}

/* MOBILE */
@media (max-width: 767px) {
  .wc-compliance {
    padding: 10px;
  }

  .wc-compliance .wc-item {
    font-size: 13px;
    padding: 14px;
  }
}


