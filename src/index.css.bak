    border-radius: 4px;
    padding: 10px !important;
    box-shadow: rgba(0, 0, 0, 0.16) 0px 1px 4px;
	transition : 0.2s ease-in-out;
	border : 1px solid transparent;
	cursor : pointer;
}

.country__card:hover{
	border : 1px solid var(--e-global-color-e7b6afb);
	background : #fff6ef !important;
}

.country__card .country__sub__title {
    font-size: 28px;
    margin-bottom: 12px;
    display: block;
    line-height: 1;
}



.border__bottom_country {
/*     border-bottom: 1px solid rgab(0,0,0,.2)!; */
    border-bottom: 1px solid rgba(0,0,0,0.2) !important;
}

.county__container_buttons .wd-list {
	display : flex;
	gap : 6px;
	flex-wrap : wrap;
	align-items : center;
	justify-content : flex-start;
	padding : 0px;
	margin : 0px ;
	flex-direction: row;
}

.county__container_buttons .wd-list > li {
    border: 1px solid rgba(0,0,0,.2)!important;
    border-radius: 4px!important;
    display: block;
    padding: 2px 6px;
}


.county__container_buttons .wd-list > li .wd-list-content{
	margin-top : -4px;
}

/* .country__card .country__sub__title{} */

/* Overlay */
.enquiry-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 9998;
    display: none;
}

/* Popup */
.enquiry-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);

    width: 900px;
    max-width: 95%;
    height: 90vh; /* 🔥 FIX */

    background: #fff;
    border-radius: 16px;
    z-index: 9999;

    display: none;
    overflow: hidden;

    transition: 0.3s ease;

    display: flex;
    flex-direction: column;
}

.enquiry-modal.active {
    transform: translate(-50%, -50%) scale(1);
}

/* Layout */
.enquiry-wrapper {
    display: flex;
    flex: 1; /* 🔥 FIX */
/*     overflow: hidden; */
    min-height: 100%;
	height : 100%;
}

/* LEFT */
.enquiry-product {
    width: 40%;
    background: #f7f7f7;
    padding: 20px;
    text-align: center;
    overflow-y: auto;
}

.enquiry-product img {
    max-width: 100%;
}

/* RIGHT FORM */
.enquiry-form {
    width: 60%;
    padding: 20px;

    flex: 1;              /* 🔥 MAIN FIX */
    overflow-y: auto;
    min-height: 0;
}

/* Fields */
.field {
    position: relative;
    margin-bottom: 15px;
}

.field input,
.field textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
}

.field label {
    position: absolute;
    top: 12px;
    left: 10px;
    background: #fff;
    padding: 0 5px;
    font-size: 12px;
}

/* Button */
/* .product-element-bottom{
	height : 100% !important;
} */

.enquiry-submit {
    width: 100%;
    padding: 12px;
    background: var(--e-global-color-e7b6afb);
    color: #fff;
    border: none;
}

/* Close */
.enquiry-close {
    position: absolute;
    top: 10px;
    right: 15px;
    cursor: pointer;
}

/* MOBILE */
@media(max-width:768px){
    .enquiry-modal {
        left: 0;
        right: 0;
        bottom: 0;
        top: auto;
        transform: translateY(100%);
        height: 80vh;
		width : 100% !important;
		max-width : 100% !important;
        border-radius: 16px 16px 0 0;
    }

    .enquiry-modal.active {
        transform: translateY(0);
    }

    .enquiry-wrapper {
        flex-direction: column;
    }

    .enquiry-product {
        width: 100%;
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .enquiry-product img {
        width: 60px;
		height : auto ;
		border-radius : 4px;
    }
	
	.enquiry-product h3{
		text-align : left;
		color : rgba(0,0,0,0.8);
		font-size : 16px !important;
	}

    .enquiry-form {
        width: 100%;
        padding-bottom: 80px;
    }

    .enquiry-submit {
        position: fixed;
        bottom: 0;
        left: 0;
    }
}

/* Trusted Brand Code Start Here */
.tb__card{
